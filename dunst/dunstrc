[global]
monitor = 0
frame_width = 1
frame_color = "#222222"
separator_color= frame
highlight = "#74c7ec"
background = "#f4f4f4"
foreground = "#444444"
corner_radius = 5
progress_bar_corner_radius = 5
corners = top-left,bottom
progress_bar_corners = top-left,bottom-right
offset = (15, 25)
gap_size = 5
format = "<b>%a</b>\n%s\n%b"
font = IosevkaTermSlab Nerd Font Regular 10
min_icon_size = 48
max_icon_size = 128
width = (300,600)

[urgency_low]
foreground = "#333333"
frame_color = "#333333"
default_icon = "~/.config/dunst/icons/bell-badge-low.svg"
timeout = 5

[urgency_normal]
foreground = "#1793D0"
frame_color = "#1793D0"
default_icon = "~/.config/dunst/icons/bell-badge.svg"
timeout = 5

[urgency_critical]
foreground = "#D01717"
frame_color = "#D01717"
default_icon = "~/.config/dunst/icons/alert-decagram.svg"
timeout = 5
