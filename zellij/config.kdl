keybinds clear-defaults=true {
    pane {
        bind "left" { MoveFocus "left"; }
        bind "down" { MoveFocus "down"; }
        bind "up" { MoveFocus "up"; }
        bind "right" { MoveFocus "right"; }
        bind "c" { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "d" { NewPane "down"; SwitchToMode "locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "h" { MoveFocus "left"; }
        bind "j" { MoveFocus "down"; }
        bind "k" { MoveFocus "up"; }
        bind "l" { MoveFocus "right"; }
        bind "n" { NewPane; SwitchToMode "locked"; }
        bind "p" { SwitchToMode "normal"; }
        bind "r" { NewPane "right"; SwitchToMode "locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "locked"; }
        bind "tab" { SwitchFocus; }
    }
    tab {
        bind "left" { GoToPreviousTab; }
        bind "down" { GoToNextTab; }
        bind "up" { GoToPreviousTab; }
        bind "right" { GoToNextTab; }
        bind "[" { BreakPaneLeft; SwitchToMode "locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "locked"; }
        bind "b" { BreakPane; SwitchToMode "locked"; }
        bind "h" { GoToPreviousTab; }
        bind "j" { GoToNextTab; }
        bind "k" { GoToPreviousTab; }
        bind "l" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "locked"; }
        bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "t" { SwitchToMode "normal"; }
        bind "x" { CloseTab; SwitchToMode "locked"; }
        bind "tab" { ToggleTab; }
    }
    resize {
        bind "left" { Resize "Increase left"; }
        bind "down" { Resize "Increase down"; }
        bind "up" { Resize "Increase up"; }
        bind "right" { Resize "Increase right"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "=" { Resize "Increase"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "h" { Resize "Increase left"; }
        bind "j" { Resize "Increase down"; }
        bind "k" { Resize "Increase up"; }
        bind "l" { Resize "Increase right"; }
        bind "r" { SwitchToMode "normal"; }
    }
    move {
        bind "left" { MovePane "left"; }
        bind "down" { MovePane "down"; }
        bind "up" { MovePane "up"; }
        bind "right" { MovePane "right"; }
        bind "h" { MovePane "left"; }
        bind "j" { MovePane "down"; }
        bind "k" { MovePane "up"; }
        bind "l" { MovePane "right"; }
        bind "m" { SwitchToMode "normal"; }
        bind "n" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "tab" { MovePane; }
    }
    scroll {
        bind "Alt left" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt down" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt up" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt right" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "e" { EditScrollback; SwitchToMode "locked"; }
        bind "f" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Alt h" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt j" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt k" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt l" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "s" { SwitchToMode "normal"; }
    }
    search {
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "n" { Search "down"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "p" { Search "up"; }
        bind "w" { SearchToggleOption "Wrap"; }
    }
    session {
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "o" { SwitchToMode "normal"; }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
    }
    shared_among "normal" "locked" {
        bind "Alt left" { Resize "Increase left"; }
        bind "Alt down" { Resize "Increase down"; }
        bind "Alt up" { Resize "Increase up"; }
        bind "Alt right" { Resize "Increase right"; }
        bind "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt F" { TogglePanePinned; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt i" { MoveTab "left"; }
        bind "Alt o" { MoveTab "right"; }
        bind "Alt y" {
            LaunchOrFocusPlugin "file:/home/walter/.config/zellij/plugins/zellij_forgot.wasm" {
                floating true
                "close pane" "ctrl + space + x"
                detach "ctrl + space + d"
                "floating/embed" "ctrl + space + f/e"
                "focus pane" "ctrl + space + r/s/n/t"
                fullscreen "ctrl + space + z"
                "new pane" "ctrl + space + n"
                "new tab" "ctrl + space + c"
                "next/previous pane" "ctrl + space + o / ;"
                prefix "ctrl + space"
                "previous/next tab" "ctrl + space + h/l"
                "quit zellij" "ctrl + space + q"
                "rename/close tab" "ctrl + space + , / &"
                "resize panes" "Alt + arrows"
                "scroll/copy" "ctrl + space + ["
                search "ctrl + space + /"
                "split right/down" "ctrl + space + \\ / -"
                "swap pane" "ctrl + space + Tab"
                "zellij modes" "ctrl + space + P/T/R/M/O"
            }
        }
    }
    shared_except "renametab" "renamepane" "tmux" {
        bind "Ctrl space" { SwitchToMode "tmux"; }
    }
    shared_except "locked" "renametab" "renamepane" {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl q" { Quit; }
    }
    shared_except "locked" "entersearch" {
        bind "enter" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" {
        bind "esc" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" "move" {
        bind "m" { SwitchToMode "move"; }
    }
    shared_except "locked" "entersearch" "search" "renametab" "renamepane" "session" "tmux" {
        bind "o" { SwitchToMode "session"; }
    }
    shared_except "locked" "tab" "entersearch" "renametab" "renamepane" "tmux" {
        bind "t" { SwitchToMode "tab"; }
    }
    shared_except "locked" "tab" "scroll" "entersearch" "renametab" "renamepane" "tmux" {
        bind "s" { SwitchToMode "scroll"; }
    }
    shared_among "normal" "resize" "tab" "scroll" "prompt" {
        bind "p" { SwitchToMode "pane"; }
    }
    shared_among "normal" "scroll" "search" "session" "move" "prompt" {
        bind "r" { SwitchToMode "resize"; }
    }
    shared_among "pane" "tmux" {
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "x" { CloseFocus; SwitchToMode "locked"; }
    }
    shared_among "tab" "tmux" {
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "Ctrl s" { ToggleActiveSyncTab; SwitchToMode "locked"; }
    }
    shared_among "scroll" "search" {
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "left" { PageScrollUp; }
        bind "down" { ScrollDown; }
        bind "up" { ScrollUp; }
        bind "right" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
        bind "d" { HalfPageScrollDown; }
        bind "Ctrl f" { PageScrollDown; }
        bind "h" { PageScrollUp; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "l" { PageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "esc" { SwitchToMode "scroll"; }
        bind "enter" { SwitchToMode "search"; }
    }
    renametab {
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" { SwitchToMode "locked"; }
    }
    renamepane {
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
    shared_among "session" "tmux" {
        bind "d" { Detach; }
    }
    tmux {
        bind "PageUp" { SwitchToMode "scroll"; }
        bind "left" { MoveFocus "left"; SwitchToMode "locked"; }
        bind "down" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "up" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "right" { MoveFocus "right"; SwitchToMode "locked"; }
        bind "space" { NextSwapLayout; SwitchToMode "locked"; }
        bind "Ctrl space" { Write 0; SwitchToMode "locked"; }
        bind "\"" { NewPane "down"; SwitchToMode "locked"; }
        bind "%" { NewPane "right"; SwitchToMode "locked"; }
        bind "&" { CloseTab; SwitchToMode "locked"; }
        bind "+" { Resize "Increase"; SwitchToMode "locked"; }
        bind "," { SwitchToMode "renametab"; TabNameInput 0; }
        bind "-" { NewPane "down"; SwitchToMode "locked"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "0" { GoToTab 1; SwitchToMode "locked"; }
        bind ";" { FocusPreviousPane; SwitchToMode "locked"; }
        bind "=" { Resize "Increase"; SwitchToMode "locked"; }
        bind "D" { Detach; }
        bind "E" { EditScrollback; SwitchToMode "locked"; }
        bind "F" { TogglePanePinned; SwitchToMode "locked"; }
        bind "K" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "M" { SwitchToMode "move"; }
        bind "N" { NewPane; SwitchToMode "locked"; }
        bind "O" { SwitchToMode "session"; }
        bind "P" { SwitchToMode "pane"; }
        bind "R" { SwitchToMode "resize"; }
        bind "S" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "T" { SwitchToMode "tab"; }
        bind "[" { SwitchToMode "scroll"; }
        bind "\\" { NewPane "right"; SwitchToMode "locked"; }
        bind "a" {
            Run "lazygit" {
                floating true
                x "5%"
                y "5%"
                width "90%"
                height "90%"
            }
            SwitchToMode "locked"
        }
        bind "," {
            Run "fish" "-c" "read -P 'Nuevo nombre del tab: ' name; and zellij action rename-tab $name" {
                name "Renombrar Tab"
                floating true
                close_on_exit true
                x "30%"
                y "45%"
                width "40%"
                height "5%"
            }
            SwitchToMode "locked"
        }
        bind "c" {
            Run "fish" "-c" "read -P 'Nombre del tab: ' name; and zellij action new-tab -n $name" {
                name "Nueva Tab"
                floating true
                close_on_exit true
                x "30%"
                y "45%"
                width "40%"
                height "5%"
            }
            SwitchToMode "locked"
        }
        bind "f" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "h" { GoToPreviousTab; SwitchToMode "locked"; }
        bind "i" { MoveTab "left"; SwitchToMode "locked"; }
        bind "l" { GoToNextTab; SwitchToMode "locked"; }
        bind "n" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "o" { FocusNextPane; SwitchToMode "locked"; }
        bind "p" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "q" { Quit; }
        bind "r" { MoveFocus "left"; SwitchToMode "locked"; }
        bind "s" { MoveFocus "right"; SwitchToMode "locked"; }
        bind "t" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "u" { MoveTab "right"; SwitchToMode "locked"; }
        bind "v" {
            Run "nvim" "todo.md" {
                floating true
                cwd "~/mimir"
                x "5%"
                y "5%"
                width "90%"
                height "90%"
            }
            SwitchToMode "locked"
        }
        bind "w" {
            Run "sh" "-c" "zellij action list-panes | tail -n +2 | fzf --reverse --prompt='Ir al panel: ' | awk '{print $1}' | xargs -r -I{} zellij action focus-pane-id {}" {
                floating true
                hold_on_close false
                x "5%"
                y "5%"
                width "90%"
                height "90%"
            }
            SwitchToMode "locked"
        }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "{" { PreviousSwapLayout; SwitchToMode "locked"; }
        bind "}" { NextSwapLayout; SwitchToMode "locked"; }
        bind "ñ" {
            Run "fish" {
                floating true
                x "20%"
                y "20%"
                width "60%"
                height "60%"
            }
            SwitchToMode "locked"
        }
        bind "tab" { MovePane; SwitchToMode "locked"; }
        bind "Shift tab" { MovePaneBackwards; SwitchToMode "locked"; }
    }
}
