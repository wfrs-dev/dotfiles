(defpoll time_str :interval "45s" "date '+%I:%M%p - %b %d (%A)'")
(defpoll cpu :interval "2s" "awk '{u+=$2+$4; t+=$2+$4+$5}; END {print int(u/t*100)}' /proc/stat")
(defpoll ram_pct :interval "3s" "free | grep Mem | awk '{printf(\"%.0f\", $3/$2 * 100.0)}'")
(defpoll ram_used :interval "3s" "free -h | grep Mem | awk '{print $3 \" / \" $2}' | sed 's/Gi/GB/g; s/Mi/MB/g'")
(defpoll disk_pct :interval "30s" "df / | awk 'NR==2 {print $5}' | tr -d '%'")
(defpoll disk_used :interval "30s" "df -h / | awk 'NR==2 {print $3 \"/\" $2}' | sed 's/Gi/GB/g; s/Mi/MB/g'")
(defpoll temp :interval "3s" "cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | awk '{print int($1/1000)}' | head -n 1")
(defpoll ip_addr :interval "10s" "ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' || echo 'Desconectado'")
(defpoll uptime :interval "60s" "uptime -p | sed 's/up //'")

(defwidget bar []
  (centerbox :orientation "h"
    (left-modules)
    (center-modules)
    (right-modules)
  ))

(defwidget left-modules []
  (box :class "modules-left" :space-evenly false :halign "start" :spacing 15
    (label :class "time-label" :text {"[󰥔  " + time_str + "]"})
    (label :class "uptime-label" :text {"[󱎫  " + uptime + "]"})
  ))

(defwidget center-modules []
  (box :class "modules-center" :space-evenly false :halign "center" :spacing 20
    (box :class "stat-box" :space-evenly false :spacing 6
      (label :class "icon" :text "[󰻠")
      (label :text {"${round(EWW_CPU.avg, 0)}%]"})
    )
    (box :class "stat-box" :space-evenly false :spacing 6
      (label :class "icon" :text "[󰍛")
      (label :text {"${round(EWW_RAM.used_mem / 1024 / 1024 / 1024, 2)} GB (${round(EWW_RAM.used_mem_perc, 0)}%)]"})
    )
    (box :class "stat-box" :space-evenly false :spacing 6
      (label :class "icon" :text "[󰋊")
      (label :text {"${disk_pct}% (${disk_used})]"})
    )
    (box :class "stat-box" :space-evenly false :spacing 6
      (label :class "icon" :text "[󰔏")
      (label :text {"${temp}°C]"})
    )
  ))

(defwidget right-modules []
  (box :class "modules-right" :space-evenly false :halign "end" :spacing 15
    (box :class "stat-box" :space-evenly false :spacing 6
      (label :class "ip-label" :text {"[󰩟  " + ip_addr + "]"})
    )
    (box :class "stat-box" :space-evenly false :spacing 6
      (label :class "ip-label" :text "[󰁹 ${EWW_BATTERY.BAT0.capacity}% (${EWW_BATTERY.BAT0.status})]"))
  ) )

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "4px"
                      :width "99%"
                      :height "18px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive true
;;  :reserve (struts :side "bottom" :distance "36px")
;;  :windowtype "dock"
  (bar))
