custom-shader = ~/.config/ghostty/cursor_warp.glsl

font-family = "IosevkaTermSlab Nerd Font Propo"
font-family-bold = "IosevkaTermSlab Nerd Font Propo"
font-family-italic = "VictorMono Nerd Font Propo"
font-family-bold-italic = "VictorMono Nerd Font Propo"
font-size = 10.5

confirm-close-surface = false

# Nord Theme for Ghostty

# Colors
background = #2e3440
foreground = #d8dee9

# Selection
selection-background = #4c566a
selection-foreground = #d8dee9

# Cursor
cursor-color = #d8dee9
cursor-text = #2e3440

# Normal colors (0-7)
palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0

# Bright colors (8-15)
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4
